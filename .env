# 生产环境优先级
# development & production & test > .env

# title
VITE_GLOB_APP_TITLE = JetBrains

# 本地存储 key 前缀
# 项目作为模板复用时建议改成当前项目唯一标识，避免多个项目共用 localStorage 配置
VITE_STORAGE_PREFIX = butterfly

# 静态资源url
VITE_IMG_BASE_URL = 'https://my-image-cdn.com'

# 本地mock数据 true开启 false关闭
VITE_APP_OPEN_MOCK = false
